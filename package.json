{
  "name": "runbook-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A portfolio-grade incident runbook workspace for operational teams.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "pretest:e2e": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "test": "node --test",
    "test:e2e": "node scripts/e2e.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.29",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prisma": "^7.9.1"
  }
}
