generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  services    Service[]
  runbooks    Runbook[]
  incidents   Incident[]
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  assigned    IncidentStep[] @relation("AssignedIncidentSteps")
  commanded   Incident[]   @relation("IncidentCommander")
  notes       IncidentNote[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(RESPONDER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Service {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  tier           ServiceTier  @default(TIER_2)
  status         ServiceStatus @default(HEALTHY)
  owner          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runbooks       Runbook[]
  incidents      Incident[]

  @@unique([organizationId, slug])
}

model Runbook {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String?
  title          String
  summary        String
  defaultSeverity IncidentSeverity @default(SEV_3)
  estimatedMinutes Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  steps          RunbookStep[]
  incidents      Incident[]
}

model RunbookStep {
  id          String   @id @default(cuid())
  runbookId   String
  position    Int
  title       String
  detail      String
  role        String
  required    Boolean  @default(true)
  timeboxMinutes Int?
  runbook     Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)
}

model Incident {
  id             String           @id @default(cuid())
  organizationId String
  serviceId      String
  runbookId      String?
  commanderId    String?
  title          String
  severity       IncidentSeverity
  status         IncidentStatus   @default(ACTIVE)
  startedAt      DateTime         @default(now())
  resolvedAt     DateTime?
  summary        String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  runbook        Runbook?         @relation(fields: [runbookId], references: [id], onDelete: SetNull)
  commander      User?            @relation("IncidentCommander", fields: [commanderId], references: [id], onDelete: SetNull)
  steps          IncidentStep[]
  notes          IncidentNote[]
  timeline       TimelineEvent[]
}

model IncidentStep {
  id          String      @id @default(cuid())
  incidentId  String
  title       String
  detail      String
  role        String
  required    Boolean     @default(true)
  status      StepStatus  @default(PENDING)
  assigneeId  String?
  completedAt DateTime?
  incident    Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("AssignedIncidentSteps", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model IncidentNote {
  id         String    @id @default(cuid())
  incidentId String
  authorId   String?
  body       String
  createdAt  DateTime  @default(now())
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model TimelineEvent {
  id         String    @id @default(cuid())
  incidentId String
  type       String
  message    String
  actorId    String?
  createdAt  DateTime  @default(now())
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

enum MemberRole {
  OWNER
  INCIDENT_COMMANDER
  RESPONDER
  VIEWER
}

enum ServiceTier {
  TIER_1
  TIER_2
  TIER_3
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum IncidentSeverity {
  SEV_1
  SEV_2
  SEV_3
  SEV_4
}

enum IncidentStatus {
  ACTIVE
  MONITORING
  RESOLVED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
}

